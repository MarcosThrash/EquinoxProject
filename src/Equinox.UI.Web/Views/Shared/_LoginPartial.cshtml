@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var accountActive = ViewContext.RouteData.Values["area"]?.ToString() == "Identity" ? "active" : "";
}

<ul class="navbar-nav">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle @accountActive" href="#" id="accountMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-user-circle"></i>
            <span class="nav-text">@(SignInManager.IsSignedIn(User) ? User.Identity.Name : "Conta")</span>
        </a>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="accountMenu">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="fas fa-user-cog"></i><span>Minha conta</span><i class="fas fa-chevron-right item-arrow"></i>
                </a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">
                        <i class="fas fa-sign-out-alt"></i><span>Logout</span><i class="fas fa-chevron-right item-arrow"></i>
                    </button>
                </form>
            }
            else
            {
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">
                    <i class="fas fa-sign-in-alt"></i><span>Login</span><i class="fas fa-chevron-right item-arrow"></i>
                </a>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">
                    <i class="fas fa-user-plus"></i><span>Register</span><i class="fas fa-chevron-right item-arrow"></i>
                </a>
            }
        </div>
    </li>
</ul>
