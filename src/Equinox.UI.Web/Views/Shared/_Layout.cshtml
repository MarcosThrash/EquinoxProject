<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Equinox Project</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.9.0/css/all.css" />
</head>
<body>
    <header>
        @{
            var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
            var isRootArea = string.IsNullOrEmpty(currentArea);
            var homeActive = isRootArea && currentController == "Home" && currentAction == "Index" ? "active" : "";
            var customerActive = isRootArea && currentController == "Customer" ? "active" : "";
            var sobreActive = isRootArea && currentController == "Home" && currentAction == "Sobre" ? "active" : "";
        }
        <div class="container">
            <nav class="navbar navbar-expand-md glass-nav">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand"><img src="~/images/logo.png" alt="Equinox Project" /></a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Abrir menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item">
                            <a class="nav-link @homeActive" asp-area="" asp-controller="Home" asp-action="Index" title="Início">
                                <i class="fas fa-home"></i><span class="nav-text">Início</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @customerActive" href="#" id="customerMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-users"></i><span class="nav-text">Customers</span>
                            </a>
                            <div class="dropdown-menu" aria-labelledby="customerMenu">
                                <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="Index">
                                    <i class="fas fa-list-ul"></i><span>Listar clientes</span><i class="fas fa-chevron-right item-arrow"></i>
                                </a>
                                <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="Create">
                                    <i class="fas fa-user-plus"></i><span>Novo cliente</span><i class="fas fa-chevron-right item-arrow"></i>
                                </a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @sobreActive" asp-area="" asp-controller="Home" asp-action="Sobre" title="Sobre">
                                <i class="fas fa-info-circle"></i><span class="nav-text">Sobre</span>
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Equinox Project - Version 1.10 - Developed by - <a href="http://eduardopires.net.br" target="_blank">Eduardo Pires</a> - This is an open-source project <a href="https://github.com/EduardoPires/EquinoxProject" target="_blank">Equinox GitHub</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

